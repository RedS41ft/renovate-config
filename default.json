{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "RedS41ft shared preset — ACTIVE repos. Non-major updates automerge behind CI; majors and core frameworks wait for review.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/London",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Automerge all non-major updates once checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Majors open a PR but never automerge — surfaced by Monday digest",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Core frameworks get their own PR and manual review even on minor",
      "matchPackageNames": ["fastapi", "sqlalchemy", "react", "react-dom", "vite"],
      "matchUpdateTypes": ["minor"],
      "groupName": "core frameworks",
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": true,
    "schedule": ["at any time"]
  }
}
